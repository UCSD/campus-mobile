<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <include layout="@layout/widget_header" />

    <include layout="@layout/widget_student" />

    <!-- White padding is the barcode's quiet zone so scanners can read it -->
    <ImageView
        android:id="@+id/barcode"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_barcode_background"
        android:clipToOutline="true"
        android:outlineProvider="background"
        android:contentDescription="Student ID barcode"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:scaleType="fitXY" />
</LinearLayout>
